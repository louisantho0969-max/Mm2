-- ==================== ESP / TRACERS ====================
local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or not player.Character then continue end
        
        local character = player.Character
        local root = character:FindFirstChild("HumanoidRootPart")
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root or not myRoot then continue end

        local role = GetPlayerRole(player)
        local color = Color3.fromRGB(0, 255, 100)
        if role == "Murderer" then color = Color3.fromRGB(255, 40, 40)
        elseif role == "Sheriff" then color = Color3.fromRGB(50, 120, 255) end

        local highlight = character:FindFirstChild("TracerHighlight")
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "TracerHighlight"
            highlight.FillTransparency = 0.45
            highlight.OutlineTransparency = 0
            highlight.Parent = character
        end
        highlight.FillColor = color
        highlight.OutlineColor = color

        if not Lines[player] then
            Lines[player] = Drawing.new("Line")
            Lines[player].Thickness = 2
            Lines[player].Transparency = 1
        end

        local line = Lines[player]
        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local myScreenPos = Camera:WorldToViewportPoint(myRoot.Position)

        line.Color = color
        line.From = Vector2.new(myScreenPos.X, myScreenPos.Y)
        line.To = Vector2.new(screenPos.X, screenPos.Y)
        line.Visible = onScreen
    end
end

local function DisableTracers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            local hl = player.Character:FindFirstChild("TracerHighlight")
            if hl then hl:Destroy() end
        end
    end
    for _, line in pairs(Lines) do line:Remove() end
    Lines = {}
end

-- ==================== AIMBOT (seulement Murder + LOS) ====================
local function AimbotLoop()
    if not AimbotEnabled then return end
    
    local murder = GetMurderer()
    if not murder or not murder.Character or not murder.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    local murderRoot = murder.Character.HumanoidRootPart
    
    if HasLineOfSight(myRoot.Position, murderRoot.Position) then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, murderRoot.Position)
    end
end

-- ==================== AUTO SHOOT (un seul appui) ====================
local function DoAutoShoot()
    if game.PlaceId ~= 142823291 then return end
    
    local murder = GetMurderer()
    if not murder or not murder.Character or not murder.Character:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    local myChar = LocalPlayer.Character
    if not myChar then return end
    
    local gun = myChar:FindFirstChild("Gun") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Gun"))
    if not gun then return end
    
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local murderRoot = murder.Character.HumanoidRootPart
    if not myRoot then return end
    
    if HasLineOfSight(myRoot.Position, murderRoot.Position) then
        -- Aim rapide
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, murderRoot.Position)
        
        if gun.Parent == LocalPlayer.Backpack then
            myChar.Humanoid:EquipTool(gun)
            task.wait(0.05)
        end
        
        gun:Activate()
    end
end

