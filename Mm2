-- // MM2 - Auto Shoot + ESP (Version corrigée)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local ESPEnabled = false
local Connections = {}

-- ==================== SCREEN GUI ====================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MM2Script"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- ==================== FONCTION CRÉATION BOUTON ====================
local function CreateButton(text, color, position)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 170, 0, 52)
    btn.Position = position
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Parent = ScreenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.6
    stroke.Parent = btn

    -- Drag
    local dragging = false
    local dragStart, startPos

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    return btn
end

local AutoShootBtn = CreateButton("AUTO SHOOT", Color3.fromRGB(255, 140, 0), UDim2.new(0.02, 0, 0.32, 0))
local ESPBtn = CreateButton("ESP : OFF", Color3.fromRGB(0, 180, 100), UDim2.new(0.02, 0, 0.42, 0))

-- ==================== DÉTECTION RÔLE ====================
local function GetRole(player)
    if not player or not player.Character then return "Innocent" end

    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")

    if char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")) then
        return "Murderer"
    end
    if char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    return "Innocent"
end

local function GetMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if GetRole(player) == "Murderer" then
            return player
        end
    end
    return nil
end

-- ==================== AUTO SHOOT ====================
local function AutoShoot()
    if GetRole(LocalPlayer) ~= "Sheriff" then
        AutoShootBtn.Text = "PAS SHERIFF !"
        task.delay(1, function()
            AutoShootBtn.Text = "AUTO SHOOT"
        end)
        return
    end

    local murder = GetMurderer()
    if not murder or not murder.Character or not murder.Character:FindFirstChild("HumanoidRootPart") then
        AutoShootBtn.Text = "PAS DE MURDER"
        task.delay(1, function()
            AutoShootBtn.Text = "AUTO SHOOT"
        end)
        return
    end

    local character = LocalPlayer.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local gun = character:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun")

    if not gun or not humanoid then return end

    -- Vise le Murder
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, murder.Character.HumanoidRootPart.Position)

    -- Équipe le gun
    if gun.Parent ~= character then
        humanoid:EquipTool(gun)
        task.wait(0.08)
    end

    -- Tire
    gun:Activate()

    -- Feedback
    AutoShootBtn.Text = "SHOT !"
    AutoShootBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 0)
    task.delay(0.6, function()
        AutoShootBtn.Text = "AUTO SHOOT"
        AutoShootBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
    end)
end

-- ==================== ESP ====================
local function UpdateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer or not player.Character then continue end

        local role = GetRole(player)
        local color = Color3.fromRGB(40, 255, 90) -- Vert (Innocent)

        if role == "Murderer" then
            color = Color3.fromRGB(255, 40, 40) -- Rouge
        elseif role == "Sheriff" then
            color = Color3.fromRGB(40, 110, 255) -- Bleu
        end

        local highlight = player.Character:FindFirstChild("RoleESP")
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "RoleESP"
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillTransparency = 0.45
            highlight.OutlineTransparency = 0
            highlight.Parent = player.Character
        end

        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.Enabled = true
    end
end

local function ClearESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local hl = player.Character:FindFirstChild("RoleESP")
            if hl then
                hl:Destroy()
            end
        end
    end
end

-- ==================== CONNEXIONS ====================
AutoShootBtn.MouseButton1Click:Connect(AutoShoot)

ESPBtn.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled

    if ESPEnabled then
        if Connections.ESP then Connections.ESP:Disconnect() end
        Connections.ESP = RunService.RenderStepped:Connect(UpdateESP)
        ESPBtn.Text = "ESP : ON"
        ESPBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 130)
    else
        if Connections.ESP then
            Connections.ESP:Disconnect()
            Connections.ESP = nil
        end
        ClearESP()
        ESPBtn.Text = "ESP : OFF"
        ESPBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
    end
end)

print("✅ Script MM2 chargé correctement")
