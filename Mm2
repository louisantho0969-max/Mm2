        AimbotBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    else
        if Connections.Aimbot then Connections.Aimbot:Disconnect() end
        AimbotBtn.Text = "AIMBOT : OFF"
        AimbotBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    end
end)

