-- // MM2 Script - Style Hacker (Auto Shoot + ESP + Auto Grab + Lock)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local PathfindingService = game:GetService("PathfindingService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local ESPEnabled = false
local AutoShootEnabled = false
local Locked = false
local Connections = {}
local Buttons = {}

-- ==================== SCREEN GUI ====================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MM2Hacker"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- ==================== CRÉATION BOUTON STYLE HACKER ====================
local function CreateButton(text, position)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 48)
    btn.Position = position
    btn.BackgroundColor3 = Color3.fromRGB(8, 12, 18)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(0, 255, 170)
    btn.TextScaled = true
    btn.Font = Enum.Font.Code
    btn.AutoButtonColor = false
    btn.Parent = ScreenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 255, 170)
    stroke.Thickness = 1.4
    stroke.Transparency = 0.3
    stroke.Parent = btn

    -- Drag
    local dragging = false
    local dragStart, startPos

    btn.InputBegan:Connect(function(input)
        if Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and not Locked and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    table.insert(Buttons, btn)
    return btn
end

local AutoShootBtn = CreateButton("[ AUTO SHOOT ]", UDim2.new(0.02, 0, 0.28, 0))
local ESPBtn       = CreateButton("[ ESP : OFF ]", UDim2.new(0.02, 0, 0.36, 0))
local GrabGunBtn   = CreateButton("[ AUTO GRAB GUN ]", UDim2.new(0.02, 0, 0.44, 0))
local LockBtn      = CreateButton("[ LOCK : OFF ]", UDim2.new(0.02, 0, 0.52, 0))

-- ==================== DÉTECTION RÔLE ====================
local function GetRole(player)
    if not player or not player.Character then return "Innocent" end
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")

    if char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")) then
        return "Murderer"
    end
    if char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    return "Innocent"
end

local function GetMurderer()
    for _, plr in pairs(Players:GetPlayers()) do
        if GetRole(plr) == "Murderer" then
            return plr
        end
    end
    return nil
end

-- ==================== AUTO SHOOT (Toggle automatique) ====================
local lastShoot = 0

local function AutoShootLoop()
    if not AutoShootEnabled then return end
    if GetRole(LocalPlayer) ~= "Sheriff" then return end

    local murder = GetMurderer()
    if not murder or not murder.Character or not murder.Character:FindFirstChild("HumanoidRootPart") then return end

    local character = LocalPlayer.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local gun = character:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun")
    if not gun or not humanoid then return end

    -- Cooldown pour éviter le spam trop rapide
    if tick() - lastShoot < 0.45 then return end

    -- Vise
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, murder.Character.HumanoidRootPart.Position)

    if gun.Parent ~= character then
        humanoid:EquipTool(gun)
        task.wait(0.05)
    end

    gun:Activate()
    lastShoot = tick()
end

-- ==================== ESP ====================
local function UpdateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer or not player.Character then continue end

        local role = GetRole(player)
        local color = Color3.fromRGB(40, 255, 90) -- Vert

        if role == "Murderer" then
            color = Color3.fromRGB(255, 40, 40)
        elseif role == "Sheriff" then
            color = Color3.fromRGB(40, 130, 255)
        end

        local highlight = player.Character:FindFirstChild("RoleESP")
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "RoleESP"
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillTransparency = 0.42
            highlight.OutlineTransparency = 0
            highlight.Parent = player.Character
        end

        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.Enabled = true
    end
end

local function ClearESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local hl = player.Character:FindFirstChild("RoleESP")
            if hl then hl:Destroy() end
        end
    end
end

-- ==================== AUTO GRAB GUN (sans TP) ====================
local function AutoGrabGun()
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end

    -- Cherche le Gun droppé dans le workspace
    local closestGun = nil
    local shortest = math.huge

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") and obj.Name == "Gun" and obj:FindFirstChild("Handle") then
            local dist = (root.Position - obj.Handle.Position).Magnitude
            if dist < shortest then
                shortest = dist
                closestGun = obj
            end
        end
    end

    if not closestGun then
        GrabGunBtn.Text = "[ NO GUN FOUND ]"
        task.delay(1.2, function()
            GrabGunBtn.Text = "[ AUTO GRAB GUN ]"
        end)
        return
    end

    GrabGunBtn.Text = "[ WALKING... ]"

    -- Marche vers le Gun (pas de TP)
    humanoid:MoveTo(closestGun.Handle.Position)

    -- Petit suivi pendant 6 secondes max
    local start = tick()
    while tick() - start < 6 do
        if not closestGun or not closestGun.Parent then break end
        if (root.Position - closestGun.Handle.Position).Magnitude < 6 then
            break
        end
        humanoid:MoveTo(closestGun.Handle.Position)
        task.wait(0.3)
    end

    GrabGunBtn.Text = "[ AUTO GRAB GUN ]"
end

-- ==================== CONNEXIONS ====================
AutoShootBtn.MouseButton1Click:Connect(function()
    AutoShootEnabled = not AutoShootEnabled
    if AutoShootEnabled then
        if Connections.AutoShoot then Connections.AutoShoot:Disconnect() end
        Connections.AutoShoot = RunService.Heartbeat:Connect(AutoShootLoop)
        AutoShootBtn.Text = "[ AUTO SHOOT : ON ]"
        AutoShootBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
    else
        if Connections.AutoShoot then Connections.AutoShoot:Disconnect() end
        AutoShootBtn.Text = "[ AUTO SHOOT ]"
        AutoShootBtn.TextColor3 = Color3.fromRGB(0, 255, 170)
    end
end)

ESPBtn.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled
    if ESPEnabled then
        if Connections.ESP then Connections.ESP:Disconnect() end
        Connections.ESP = RunService.RenderStepped:Connect(UpdateESP)
        ESPBtn.Text = "[ ESP : ON ]"
        ESPBtn.TextColor3 = Color3.fromRGB(0, 255, 100)
    else
        if Connections.ESP then Connections.ESP:Disconnect() end
        ClearESP()
        ESPBtn.Text = "[ ESP : OFF ]"
        ESPBtn.TextColor3 = Color3.fromRGB(0, 255, 170)
    end
end)

GrabGunBtn.MouseButton1Click:Connect(AutoGrabGun)

LockBtn.MouseButton1Click:Connect(function()
    Locked = not Locked
    if Locked then
        LockBtn.Text = "[ LOCK : ON ]"
        LockBtn.TextColor3 = Color3.fromRGB(255, 50, 50)
    else
        LockBtn.Text = "[ LOCK : OFF ]"
        LockBtn.TextColor3 = Color3.fromRGB(0, 255, 170)
    end
end)

print("✅ MM2 Hacker Script chargé")
